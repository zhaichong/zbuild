{
  "name": "zbuild",
  "version": "1.0.6",
  "private": true,
  "description": "智慧病房系统构建与调试工具 — Vue 3 + Vite + Web",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "web": "py scripts/start_web.py --open",
    "setup:runtime": "powershell -ExecutionPolicy Bypass -File tools\\setup_runtime.ps1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.vue",
    "format": "prettier --write src/",
    "test:py": "py -m unittest discover -s scripts/tests -v"
  },
  "dependencies": {
    "lucide-vue-next": "^0.300.0",
    "pinia": "^2.1.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  },
  "volta": {
    "node": "22.22.2"
  }
}
